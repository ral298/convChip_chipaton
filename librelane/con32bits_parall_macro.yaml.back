# Standalone hardening config for the counter macro.
# Runs the LibreLane Classic flow against rtl/counter.sv, producing the
# GDS / LEF / Liberty / Verilog netlist views that chip_top_multi
# later pulls in under `MACROS:`.

meta:
  version: 3
  flow: Classic

DESIGN_NAME: con32bits_parall

VERILOG_FILES:  
  - dir::../rtl/con32bits_parall.v
  - dir::../rtl/punt_mo_seg.v
  - dir::../rtl/suma_16b.v
  - dir::../rtl/mult_16b_bf.v
# Single-clock 8-bit register. Match the template's 25 MHz.
CLOCK_PORT: clock
CLOCK_NET: clock
CLOCK_PERIOD: 20   # ns

# Small block -- let LibreLane size the die from utilisation.
#FP_SIZING: "absolute"
#DIE_AREA: [0, 0, 2000, 2000]
FP_SIZING: relative
FP_CORE_UTIL: 40
#PL_TARGET_DENSITY_PCT: 30
PL_TARGET_DENSITY_PCT: 20

MAX_FANOUT_CONSTRAINT: 16

#CTS_CLK_BUFFERS:
#  - gf180mcu_fd_sc_mcu7t5v0__clkbuf_2
#  - gf180mcu_fd_sc_mcu7t5v0__clkbuf_4

#CTS_ROOT_BUFFER: gf180mcu_fd_sc_mcu7t5v0__clkbuf_4
CTS_CLK_BUFFERS:
  - gf180mcu_fd_sc_mcu7t5v0__clkbuf_2
  - gf180mcu_fd_sc_mcu7t5v0__clkbuf_4
  - gf180mcu_fd_sc_mcu7t5v0__clkbuf_8

CTS_ROOT_BUFFER: gf180mcu_fd_sc_mcu7t5v0__clkbuf_4


EXTRA_EXCLUDED_CELLS:
 - gf180mcu_fd_sc_mcu7t5v0__clkbuf_12
 - gf180mcu_fd_sc_mcu7t5v0__clkbuf_16
 - gf180mcu_fd_sc_mcu7t5v0__clkbuf_20
 


DIODE_INSERTION_STRATEGY: 3
DIODE_PADDING: 2


# Power / ground nets.
VDD_NETS:
  - VDD
GND_NETS:
  - VSS

# Signoff / streamout.
PRIMARY_GDSII_STREAMOUT_TOOL: klayout

# Routing / ESD.
RT_MIN_LAYER: Metal2
RT_MAX_LAYER: Metal5 #originalmente estaba en 4 y en false el pdn multilayer
#PDN_MULTILAYER: true



# Power distribution network (straps + pitch).
PDN_VWIDTH: 1.6
PDN_HWIDTH: 1.6
PDN_VSPACING: 2
PDN_HSPACING: 2
PDN_VPITCH: 100
PDN_HPITCH: 100
PDN_EXTEND_TO: boundary


# CTS defaults.
CTS_CLK_MAX_WIRE_LENGTH: 20
CTS_DISTANCE_BETWEEN_BUFFERS: 30
CTS_SINK_CLUSTERING_SIZE: 30
CTS_SINK_CLUSTERING_MAX_DIAMETER: 60

# Margins.
TOP_MARGIN_MULT: 5
BOTTOM_MARGIN_MULT: 5
LEFT_MARGIN_MULT: 5
RIGHT_MARGIN_MULT: 5

# Area-first synthesis (the counter is tiny, we do not need effort).
#SYNTH_STRATEGY: "AREA 1" #estaba originalmente en area 2
SYNTH_STRATEGY: "DELAY 1"
# Route-routeability knob for very small designs.
GRT_ALLOW_CONGESTION: false

# Per-macro DRC / LVS stays enabled; they are cheap on a block this
# small and give a green baseline before integration.
