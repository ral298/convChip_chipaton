    (COND A==1'b1&&IE==1'b0&&SL==1'b0
     (IOPATH OE PAD (0.000:0.000:0.000)))
    (COND IE==1'b0&&OE==1'b1&&SL==1'b1
     (IOPATH A PAD (0.000:0.000:0.000)))
    (COND IE==1'b0&&OE==1'b1&&SL==1'b0
     (IOPATH A PAD (0.000:0.000:0.000)))
    (COND CS==1'b1&&IE==1'b1&&OE==1'b0
     (IOPATH PAD Y (0.000:0.000:0.000)))
    (COND CS==1'b0&&IE==1'b1&&OE==1'b0
     (IOPATH PAD Y (0.000:0.000:0.000)))
   )
  )
